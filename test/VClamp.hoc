// mode
double mode[1]
mode = 1
celsius = 34

// Load NEURON
load_file("nrngui.hoc")

// Create a single-compartment neuron
create soma

// Define the morphology and properties
access soma
soma {
    insert pas  // Passive membrane properties
    diam = 1    // Diameter in microns
    L = 1    // Length in microns
    Ra = 100     // Axial resistance in ohm-cm
    cm = 0.8       // Membrane capacitance in uf/cm^2
    g_pas = 1/11150  // Specific membrane conductance in S/cm^2
    e_pas = -85   // Reversal potential for passive properties in mV
    // insert kir2
    // gkbar_kir2 = gkbar_kir2 * 1e4 //equal to 10K channel on soma
    // insert kleak
    // gleak_kleak = gleak_kleak * 1e4
    // // insert twik
    // ko = 5
}



// Set up voltage clamp parameters
objref vclamp
vclamp = new SEClamp(0.5)  // Voltage clamp at the center of the soma
vclamp.dur1 = 100  // Duration of the voltage step in ms
vclamp.amp1 = 0  // Holding potential in mV

// // Set up NMDA
objref sNMDA, stim, nc
stim = new NetStim(.5)
	stim.interval = 1		//ms (mean) time between spikes
	stim.number = 1			//(average) number of spikes
	stim.start 	= 100	//ms (most likely) start time of first spike
	stim.noise 	= 0			//---- range 0 to 1. Fractional randomness.
        
{sNMDA = new Exp5NMDA(.5)}
nc = new NetCon(stim, sNMDA)

proc init_NMDA() {
    sNMDA.multiple = 1
    nc.weight = $1
    nc.delay = 0
    }
    objref FinNMDA
    
SynWeight = 1.2
// FinNMDA = new FInitializeHandler(3,"init_NMDA(SynWeight)")
init_NMDA(SynWeight)

// Create a vector for voltage steps
objref v_steps
v_steps = new Vector()
for (v = -60; v <= 60; v = v + 30) {
    v_steps.append(v)
}

double max_index[1]

// Run voltage clamp steps
objref imax_list, tvec_list, vvec_list,ivec_list, tvec, vvec,ivec, ekvec
tvec_list = new List()
vvec_list = new List()
ivec_list = new List()
imax_list = new Vector()

objref tmpList

for i = 0, v_steps.size - 1 {
    // vclamp.dur2 = 200  // Duration of the voltage step in ms
    // vclamp.amp2 = v_steps.x[i]  // Command voltage in mV during the step

    // Set up simulation parameters
    t = 0
    dt = 0.1
    v_init = -85
    tstop = 400
    // Record and store the results
    tvec = new Vector()
    vvec = new Vector()
    ivec = new Vector()
    ekvec = new Vector()
    vvec.record(&soma.v(0.5))
    ekvec.record(&soma.v(0.5))
    tvec.record(&t)
    if (mode  == 1) {
        ivec.record(&sNMDA.i)
    } else {
        ivec.record(&soma.ik(0.5))
    }

    // Run the simulation
    init()
    run()
    
    vvec_list.append(vvec.c)
    if (mode > 1) {
        ivec_list.append(ivec.c.mul(area(0.5) * 0.01 * 1e3/0.8)) // pA.pF for whole cell        
        }
    if (mode > 0) {
        ivec_list.append(ivec.c) // nA for whole cell
    } else {
        ivec_list.append(ivec.c.mul(area(0.5) * 0.01)) // nA for whole cell
    }
    tmpList = ivec_list.o[ivec_list.count() - 1].c
    max_index = tmpList.c.abs().max_ind()
    imax_list.append(tmpList.x[max_index]) // pA for whole cell

    // Print simulation time for each step
    printf("Step %g - Command Voltage: %g mV\n", i + 1, v_steps.x[i])
}


// Plot the results
objref g, legend
strdef label
g = new Graph()
g.size(100,tstop,-0.001,0.001)
for i = 0, v_steps.size - 1 {
    ivec_list.o[i].plot(g,tvec)
}
g.xaxis(2)
g.save_name("graphList[0].")
graphList[0].append(g)
// //normalize imax
// print(abs(imax_list.x[0]))
// imax_list.div(abs(imax_list.x[0]))

// Save the plot
g.flush()
g.printfile("vc.psf")

g = new Graph()
g.size(v_steps.x[0],v_steps.x[v_steps.size - 1],-1,1)
imax_list.plot(g,v_steps)
g.save_name("graphList[0].")
graphList[0].append(g)
g.printfile("IV.psf")

