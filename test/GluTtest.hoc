load_file("stdgui.hoc")

tstop = 500

create soma
create dend
soma connect dend(0),1

create PAP
dend connect PAP(0),1

topology()

v_init = -85
    forall {
        Ra = 100
        cm = 0.8
        insert pas
        e_pas = -85
        g_pas = 1 /  11150

        insert kir2
        insert twik
        insert kleak
        insert naleak
        insert clleak
        //optimized for -80 mV
        
        insert k_acc
        insert na_acc
        // insert kdrglia
        // insert kdifl
        // ki0_kdifl = 110
    }
proc initIon(){local iki,inai
    iki = 80 //ek set to -92
    inai = 15 // Verhratsky A 2019 review
    
    // set global Ki
    ki0_k_ion = iki
    nai0_na_ion = inai

    
    // set initial Ko Ki
    forall {
        nao = 140
        ko = 2.5
        clo = nao + ko
        ki = iki
        nai = inai
    }
}

forall {psection()}

objref FinIon
{FinIon = new FInitializeHandler(1,"initIon()")}


objref sGlut,stim,nc,iGluT,g

stim = new NetStim(0.5)
stim.interval = 1
stim.number = 1
stim.start = 100
stim.noise = 0

PAP sGlut = new GluTrans(0.5)
sGlut.multiple = 1e7

nc = new NetCon(stim,sGlut)


g = new Graph()
g.size(0,tstop/dt,-0.1,0.1)
iGluT = new Vector()
iGluT.record(&sGlut.iGluT)

proc init_GluT(){
    nc.weight = $1 // weight used as parm for Glu Conc
    nc.delay = 0
}
objref FinNMDA

SynWeight = 1e3
FinNMDA = new FInitializeHandler(3,"init_GluT(SynWeight)")

init()
run()

iGluT.plot(g)
g.printfile("GluTest.psf")