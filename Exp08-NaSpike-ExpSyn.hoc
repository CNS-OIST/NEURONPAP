/* In this experiment we want to depolarize NMDA on an astrocyte modeled membrane
We will examine the depolarization after injection of current.
*/

load_file("nrngui.hoc")
load_file("params.hoc")

//fully activates cache efficiency
cvode.cache_efficient(1)  

tstop = 200
dt = .025
celsius = 18	//room temperature in Clarke08 experiment = ?
v_init = -85

// ------------------ THE BRANCH
// create branch
// access branch

// L = 30
// diam = 1

// Ra = 100                // Ohm cm 
// cm = 0.8                // uF/cm2
// nseg = 10              // seg/5 um
// insert pas
// e_pas = -85             // mV 
// g_pas = 1/11150         // mS/cm2


// insert k_ion
// ko_k_ion=3
// ki_k_ion=110

// insert kdrglia         // delayed rectifier
// insert kpump           // kpump
// insert kir4            // K inward rectifier 4
// gkir_kir4=0

// insert kdifl           // k difusion lateral
// insert GluTrans


// ------------------ THE PAP
create pap
// connect pap(0), branch(1)
access pap

// ------------------ Astrcyte leaf membrane parms from CellInit.hoc

// L = 0.3                 // um from previous Ryo Model
//diam = 0.02             // um from previous Ryo Model

Ra = 100                // Ohm cm 
cm = 0.8                // uF/cm2
nseg = 10              // seg/5 um
insert pas
e_pas = -85             // mV 
g_pas = 1/11150         // mS/cm2


insert k_ion
ko_k_ion=3
ki_k_ion=110

insert kdrglia         // delayed rectifier
insert kpump           // kpump
insert kir4            // K inward rectifier 4
gkir_kir4=0

insert kdifl           // k difusion lateral
insert GluTrans
psection()


objref ic, vc, vRec, tRec, vFile, tFile
double unit[1]

proc clampSwitch () {
    //------------Voltage Clamp---------------------------	
    if ($1 > 1) {
        vRec = new Vector(570)
        tRec = new Vector(570)
        vFile = new File()
        tFile = new File()
        
        vFile.ropen("./Data/Exp10-Clarke08-Fig10/vNaSpike.dat")
        tFile.ropen("./Data/Exp10-Clarke08-Fig10/tNaSpike.dat")
        
        vc = new VClamp(.5)
        vc.dur[0] = tstop
        
        vRec.scanf(vFile)
        tRec.scanf(tFile)
        vRec.play(&vc.amp[0],tRec)    
        // vRec.printf()
    } else if ($1 > 0) {
        vc = new VClamp(.5)
        vc.dur[0] = tstop   // ms half of tstop
        vc.amp[0] = v_init + 20 // mV depolarization
    } else {
        //------------Current Clamp---------------------------	
        ic = new IClamp(.5)
        // ic.del = tstop / 2 // ms delay half of tstop
        ic.dur = tstop //ms half of tstop
        unit =  0.010 // fA
        ic.amp = 1 * unit // nA current injection (1 pA)
        //---------------------------------------------------
    }
}

clampSwitch(0) //use different mode

Tau1 = 2.1343
Wtau2 = 0.65
Tau2_0 = 33.129
A2 = 2.9907
B2 = 0.0243
Tau3_0 = 217.69
A3 = 34.69
B3 = 0.01
k0 = 6.9172
DELTA = 0.99128

objref sNMDA, stim, nc
stim = new NetStim(.5)
	stim.interval = 1		//ms (mean) time between spikes
	stim.number = 1			//(average) number of spikes
	stim.start 	= 1.534 - 1	//ms (most likely) start time of first spike
	stim.noise 	= 0			//---- range 0 to 1. Fractional randomness.
//	0 deterministic, 1 intervals have negexp distribution.
//        Artificial Stimulus to PAP (compatible with astrocyte?)

{sNMDA = new Exp4NMDA2(.5) SynWeight = 0.54609} // Our Model 2012 Synaptic Conductance 
// {sNMDA = new Exp5NMDA4(.5) SynWeight = 0.57262 } // Our Model - modifed to have voltage dependent gFAST, 2012
// sNMDA = new Exp5NMDA(.5)


nc = new NetCon(stim, sNMDA) //Removed synaptic input (no synaptic conductance on PAP)

proc init_NMDA() {
	nc.weight = SynWeight
	nc.delay = 1
	
	sNMDA.tau1 = Tau1
	sNMDA.tau2_0 = Tau2_0
	sNMDA.a2 = A2
	sNMDA.b2 = B2
	sNMDA.wtau2 = Wtau2
	sNMDA.tau3_0 = Tau3_0
	sNMDA.a3 = A3
	sNMDA.b3 = B3
	sNMDA.K0 = k0
	sNMDA.delta = DELTA
}
objref FinNMDA
FinNMDA = new FInitializeHandler(3,"init_NMDA()")
	
//-------Graph----------------------	
objref iNMDA, vSoma
iNMDA = new Graph()
iNMDA.size(0,tstop,-10,5)
iNMDA.addvar("sNMDA.i",3,0)
iNMDA.save_name("graphList[0].")
graphList[0].append(iNMDA)

vSoma = new Graph()
vSoma.size(0,tstop,-100,100)
vSoma.addvar("pap.v(.5)",3,0)
vSoma.save_name("graphList[0].")
graphList[0].append(vSoma)

//------Save Simulated NMDA Current
objref iNMDA, iFile, time, tFile, vSoma, vFile
iNMDA = new Vector()
iNMDA.record(&sNMDA.i)
iFile = new File("iFile.dat")
iFile.wopen("iFile.dat")

vSoma = new Vector()
vSoma.record(&pap.v(0.5))
vFile = new File("vFile.dat")
vFile.wopen("vFile.dat")

time = new Vector()
time.record(&t)
tFile = new File("tFile.dat")
tFile.wopen("tFile.dat")

init()
run()

iNMDA.printf(iFile)
iFile.close()


vSoma.printf(vFile)
vFile.close()

time.printf(tFile)
tFile.close()