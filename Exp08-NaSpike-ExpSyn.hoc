objref iNMDA, iFile, time, tFile, vSoma, vFile
iNMDA = new Vector()
iNMDA.record(&sNMDA.i)
iFile = new File("iFile.dat")
iFile.wopen("iFile.dat")

vSoma = new Vector()
vSoma.record(&pap.v(0.5))
vFile = new File("vFile.dat")
vFile.wopen("vFile.dat")

time = new Vector()
time.record(&t)
tFile = new File("tFile.dat")
