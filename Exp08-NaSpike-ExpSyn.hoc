Tau1 = 2.1343
Wtau2 = 0.65

Tau2_0 = 33.129
A2 = 2.9907
B2 = 0.0243
Tau3_0 = 217.69
A3 = 34.69
B3 = 0.01

k0 = 6.9172
// wFile = new File()   
// wFile.ropen("./results/optimize/optDelta.dat")
// DELTA = wFile.scanvar()
// wFile.close()
DELTA = 0.99128


objref sNMDA, stim, nc
stim = new NetStim(.5)
	stim.interval = 1		//ms (mean) time between spikes
	stim.number = 1			//(average) number of spikes
	// stim.start 	= 1.534 - 1	//ms (most likely) start time of first spike
        stim.start = 10
	stim.noise 	= 0			//---- range 0 to 1. Fractional randomness.
//	0 deterministic, 1 intervals have negexp distribution.
//        Artificial Stimulus to PAP (compatible with astrocyte?)

{sNMDA = new Exp5NMDA(.5) } // Our Model 2012 Synaptic Conductance 
// {sNMDA = new Exp5NMDA4(.5) SynWeight = 0.57262 } // Our Model - modifed to have voltage dependent gFAST, 2012
// sNMDA = new Exp5NMDA(.5)


nc = new NetCon(stim, sNMDA) 

proc init_NMDA() {
	nc.weight = $1
	// nc.delay = 1
	nc.delay = 0
	
	sNMDA.tau1 = Tau1
	sNMDA.tau2_0 = Tau2_0
	sNMDA.a2 = A2
	sNMDA.b2 = B2
	sNMDA.wtau2 = Wtau2
	sNMDA.tau3_0 = Tau3_0
	sNMDA.a3 = A3
	sNMDA.b3 = B3
	sNMDA.K0 = k0
	sNMDA.delta = DELTA
    }
    objref FinNMDA
    
wFile = new File()   
wFile.ropen("./results/optimize/optW.dat")
SynWeight = wFile.scanvar()
wFile.close()

// SynWeight = 0.57262
FinNMDA = new FInitializeHandler(3,"init_NMDA(SynWeight)")
	
