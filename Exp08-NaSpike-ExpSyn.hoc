// insert kdifl           // k difusion lateral
// insert GluTrans
psection()


objref ic, vc, vRec, tRec, vFile, tFile
double unit[1]

proc clampSwitch () {
    //------------Voltage Clamp---------------------------	
    if ($1 > 1) {
        vRec = new Vector(570)
        tRec = new Vector(570)
        vFile = new File()
        tFile = new File()
        
        vFile.ropen("./Data/Exp10-Clarke08-Fig10/vNaSpike.dat")
        tFile.ropen("./Data/Exp10-Clarke08-Fig10/tNaSpike.dat")
        
        vc = new VClamp(.5)
        vc.dur[0] = tstop
        
        vRec.scanf(vFile)
        tRec.scanf(tFile)
        vRec.play(&vc.amp[0],tRec)    
        // vRec.printf()
    } else if ($1 > 0) {
        vc = new VClamp(.5)
        vc.dur[0] = tstop/2   // ms half of tstop
        vc.amp[0] = -65 // mV depolarization (dV = 20)
    } else {
        //------------Current Clamp---------------------------	
        ic = new IClamp(.5)
        // ic.del = tstop / 2 // ms delay half of tstop
        ic.dur = dt //ms half of tstop
        ic.del = 10 // ms starts with glutamate 
        unit =  0.000001 // fA
        ic.amp = 1 * unit // nA current injection (1 pA)
        //---------------------------------------------------
    }
}

clampSwitch(0) //use different mode


