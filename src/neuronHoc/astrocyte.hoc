obfunc getLeaf() {localobj sec,leaf
    forsec $o1 {
        sec = new SectionRef()
        // psection()
        if (sec.nchild == 0) {
            leaf = new SectionRef()
        }
    }
    return leaf
}

// inserting NMDARs
objref sNMDA, NMDAs, stim, nc, ncNMDAList

NMDAs = new List()
ncNMDAList = new List()

stim = new NetStim(.5)
stim.interval = 1
stim.number = 1
stim.start = 50
stim.noise = 0

// slPAP.printnames()
// print(lenPAP)
proc setNMDAs(){local lenPAP
    lenPAP = 0
    // $o1.printnames()
    forsec $o1 {
        sNMDA = new Exp5NMDA(0.5)
        // sNMDA = new SimpleNMDA(0.5)
        NMDAs.append(sNMDA)
        nc = new NetCon(stim,NMDAs.o(lenPAP))
        ncNMDAList.append(nc)
        lenPAP = lenPAP + 1
    }
}

proc fINITNMDA(){
    for i = 0, ncNMDAList.count - 1 {
        ncNMDAList.o(i).weight = 1
        ncNMDAList.o(i).delay = 0
        // print(nc.weight)
    }
}
objref FinNMDA
FinNMDA = new FInitializeHandler(3,"fINITNMDA()")

objref sGluT, GluTs,ncGluList

GluTs = new List()
ncGluList = new List()

proc setGluTs(){local lenPAP localobj sref
    // $o1.printnames()
    lenGluTs = 0
    forall {
        sGluT = new GluTrans(0.5)
        GluTs.append(sGluT)
        ifsec $o1 {
            // psection()
            
            // print(lenPAP)
            ncGluList.append(nc)
            nc = new NetCon(stim,sGluT)
        }
        lenGluTs = lenGluTs + 1
    }

}

proc fINITGLUT(){
    for i = 0, ncGluList.count - 1 {
        ncGluList.o(i).weight = 1
        ncGluList.o(i).delay = 0
        // print(nc.weight)
    }
}
objref FinGluT
FinGluT = new FInitializeHandler(3,"fINITGLUT()")



//initialize Ko
proc initIon(){local iki,inai
    iki = 80 //ek set to -92
    inai = 15 // Verhratsky A 2019 review
    
    // set global Ki
    ki0_k_ion = iki
    nai0_na_ion = inai

    
    // set initial Ko Ki
    forall {
        nao = 140
        ko = 2.5
        clo = nao + ko
        ki = iki
        nai = inai
    }
}


objref FinIon
{FinIon = new FInitializeHandler(1,"initIon()")}

// Experimental manipulations
proc setK(){local tmp localobj sref
    // $o1.printnames()
    forsec $o1 {
        sref = new SectionRef()
        flag_k_acc = 1
        // print(getPAPK(sref))
        ko = $2 + getPAPK(sref)
        // print(getPAPK(sref))
        if ($4 == 1){ //instantaneous switch of bath
            flag_k_acc = 1
            ko0_k_acc = $2 + getPAPK(sref)
        } else {
            flag_k_acc = 0
            ko0_k_acc = $3
        }
        // psection()
        // printf("%g\n",getPAPK(sref))
    }
    soma sref = new SectionRef()
    // printf("%g\n",getPAPK(sref))
}

