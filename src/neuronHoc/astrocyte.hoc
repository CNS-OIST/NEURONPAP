objref ic,vc,electrodeList
{electrodeList = new List()}

proc delaysec() {
  vc.rs = 1e9
  //depends on cvode
  cvode.event($1, "vc.rs = 0.001")
}
objref fih


proc clampSwitch() {
  if ($1 > 4){
        // voltage clamp
        soma {vc = new SEClamp(0.01)}
        vc.dur1 = tstop
        vc.amp1 = $2  // mV depolarization (dV = 20)
        electrodeList.append(vc)
        //---------------------------------------------------
     } else if ($1 > 3) {
        getLeaf(slPAP) {vc = new SEClamp(0.5)}
        vc.dur[0] = tstop
        vc.amp[0] = $2   // mV depolarization (dV = 20)
        electrodeList.append(vc)
    } else if ($1 > 1) {
        //------------current Clamp---------------------------
        if ($1 > 2){
            soma {ic = new IClamp(0.5)}
        } else {
            getLeaf(slPAP) {ic = new IClamp(0.5)}
        }
        ic.dur = tstop - 20
        ic.del = 0  // ms starts with glutamate
        ic.amp = $2   // nA current injection (1 pA)
        electrodeList.append(ic)
        //---------------------------------------------------
    } else if ($1 > 0) {
        // voltage clamp
        soma {vc = new SEClamp(0.5)}
        vc.dur1 = tstop
        vc.amp1 = $2  // mV depolarization (dV = 20)
        electrodeList.append(vc)
        //---------------------------------------------------
        
    } else {
        // Pulse Current
        getLeaf(slPAP) {ic = new IClamp(0.5)}
        ic.dur = 0.002
        ic.delay = 10  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection
        electrodeList.append(ic)
        //---------------------------------------------------
    }
}


// Function to plot neuron topology with highlighted sections
proc plot_topology() {localobj rando, sref,slPAP,ps
    sref = new SectionList()
    soma { sref.wholetree() }
    // Plot the astrocyte's topology
    ps = new PlotShape(sref)
    
    // $o1.printnames()
    
    // Settings
    // ps.exec_menu("Shape Plot")
    ps.exec_menu("Show Diam")
    // Save the plot as a PostScript file
    ps.color_all(1)
    // if possible set custom color
    soma ps.color(3)
    ps.color_list($o2,4)
    
    ps.beginline()
    ps.line(30,-30)
    ps.line(50,-30)
    ps.flush()
    
    ps.printfile($s1)
}
proc plot_varMorph() {localobj rando, sref,slPAP,ps
    sref = new SectionList()
    soma { sref.wholetree() }
    // Plot the astrocyte's topology
    ps = new PlotShape(sref)
    ps.variable($s1) // plot variable 2
    if (strcmp($s1,"v")==0){
        ps.scale(-90,-10)
    } else if (strcmp($s1,"ko")==0) {
        ps.scale(3,10)
    } else if (strcmp($s1,"Ri_inputRes")==0) {
        ps.scale(0,1500)
    } else if (strcmp($s1,"diam")==0) {
        ps.scale(0,5)
    } else if (strcmp($s1,"nseg")==0) {
        ps.scale(0,10)
    }
    ps.exec_menu("Shape Plot")
    ps.exec_menu("Show Diam")
    ps.flush()
    ps.printfile($s2)//print as arg 2 file name
}

proc plotPAP_topology() {local x,y,count,size localobj rando, sref,slPAP,ps
    size = 10
    sref = new SectionList()
    soma { sref.wholetree() }// Think of a way to zoom
    // Plot the astrocyte's topology
    ps = new PlotShape(sref)
    ps.color_all(1)
    
    soma sref = new SectionRef()
    // $o2.printnames()
    
    // Highlight specified sections
    ps.color_list($o2,2)
    x = 0
    y = 0
    count = 0
    forsec $o2 {
        x = x + x3d(0.5)
        y = y + y3d(0.5)
        count = count + 1
        ps.len_scale(10)
    }
    x = x / count
    y = y / count
    // Settings
    ps.exec_menu("Shape Plot")
    ps.exec_menu("Show Diam")
    ps.size(x-size,x+size,y+size,y-size)
    // ps.view(x-size,y-size,2*size,2*size,0,0,size*20,size*20)
    ps.flush()
    ps.printfile($s1)
}

proc plotPAP_varMorph() {local size localobj rando, sref,slPAP,ps
    size = 10
    sref = new SectionList()
    soma { sref.wholetree() }
    // Plot the astrocyte's topology
    ps = new PlotShape(sref)
    ps.variable($s1) // plot variable 2
    if (strcmp($s1,"v")==0){
        ps.scale(-80,-60)
    } else if (strcmp($s1,"ko")==0) {
        ps.scale(3.5,5)
    }
    soma sref = new SectionRef()
    // $o3.printnames()
    
    // Highlight specified sections
    ps.color_list($o3,2)
    x = 0
    y = 0
    count = 0
    forsec $o3 {
        x = x + x3d(0.5)
        y = y + y3d(0.5)
        count = count + 1
        ps.len_scale(10)
    }
    x = x / count
    y = y / count
    // Settings
    ps.exec_menu("Shape Plot")
    ps.exec_menu("Show Diam")
    ps.size(x-size,x+size,y+size,y-size)
    // ps.view(x-size,y-size,2*size,2*size,0,0,size*20,size*20)
    ps.flush()
    ps.printfile($s2)//print as arg 2 file name
}


proc measure_input_resistance() {localobj zz
    zz = new Impedance()
    zz.loc(0.5)  // sets origin for impedance calculations to middle of section
    zz.compute(0)  // DC input R
    Ri_inputRes = zz.input(0.5)
}

proc getAllRi() {localobj all_sections
    all_sections = new SectionList()
    all_sections.wholetree()
    
    forsec all_sections {  // Loop over all sections
        print secname()
        insert inputRes
        measure_input_resistance()
    }
}


