objref nil

strdef astro_name
astro_name = "CA1"
celsius = 34

// clear morphology

{
    forall {
        delete_section()
    }
    
    // load morphology file
    //xopen("./Geometry/threeCompartmentGeom.hoc")
    {xopen("./Geometry/GeometryAstrocyteCA1.hoc")}
    
    // inserting membrane mechanisms
    forall {
        Ra = 100
        cm = 0.8
        insert pas
        e_pas = -80
        g_pas = 1 /  11150

        insert kir2
        insert twik
        insert kleak
        insert naleak
        insert clleak
        //optimized for -80 mV
        
        insert k_acc
        insert na_acc
        // insert kdrglia
        // insert GluTrans
        // insert kdifl
        // ki0_kdifl = 110
    }
}
// inserting NMDARs
objref sNMDA, stim, nc

stim = new NetStim(.5)
stim.interval = 1
stim.number = 1
stim.start = 50
stim.noise = 0

PAP {sNMDA = new Exp5NMDA(0.5)}
nc = new NetCon(stim,sNMDA)


proc fINITNMDA(){
    nc.weight = 1.26
    nc.delay = 0
    // print(nc.weight)
}
objref FinNMDA
FinNMDA = new FInitializeHandler(3,"fINITNMDA()")



//initialize Ko
proc initIon(){local iki,inai
    iki = 80 //ek set to -92
    inai = 15 // Verhratsky A 2019 review
    
    // set global Ki
    ki0_k_ion = iki
    nai0_na_ion = inai

    
    // set initial Ko Ki
    forall {
        nao = 140
        ko = 2.5
        clo = nao + ko
        ki = iki
        nai = inai
    }
}


objref FinIon
{FinIon = new FInitializeHandler(1,"initIon()")}

// Experimental manipulations
proc setK(){
    forsec "PAP" {
        if ($3 == 1){ //instantaneous switch of bath
            flag_k_acc = 1
        } else {
            flag_k_acc = 0
        }
        ko = $1
        ko0_k_acc = $2
        // psection()
    }
    forsec "soma" "branch"{
        flag_k_acc = 0
        ko0_k_acc = 2.5
    }
}

func getPAPK(){
    forsec "PAP"{
        return ko
    }
}

objref ic,vc,electrodeList
{electrodeList = new List()}

proc clampSwitch() {
    if ($1 > 1) {
        //------------current Clamp---------------------------
        if ($1 > 2){
            soma {ic = new IClamp(0.5)}
        } else {
            PAP {ic = new IClamp(0.5)}
        }
        ic.dur = tstop
        ic.del = 0  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection (1 pA)
        electrodeList.append(ic)
        //---------------------------------------------------
    } else if ($1 > 0) {
        // voltage clamp
        PAP {vc = new VClamp(0.5)}
        vc.dur[0] = tstop
        vc.amp[0] = $2  // mV depolarization (dV = 20)
        electrodeList.append(vc)
        //---------------------------------------------------
        
    } else {
        // Pulse Current
        PAP {ic = new IClamp(0.5)}
        ic.dur = 0.002
        ic.delay = 10  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection
        electrodeList.append(ic)
        //---------------------------------------------------
    }
}



