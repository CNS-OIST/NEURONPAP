proc measure_input_resistance() {localobj zz
    zz = new Impedance()
    zz.loc(0.5)  // sets origin for impedance calculations to middle of section
    zz.compute(0)  // DC input R
    Ri_inputRes = zz.input(0.5)
}

proc getAllRi() {localobj all_sections
    all_sections = new SectionList()
    all_sections.wholetree()
    
    forsec all_sections {  // Loop over all sections
        print secname()
        insert inputRes
        measure_input_resistance()
    }
}
