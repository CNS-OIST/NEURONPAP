    // set global Ki
    ki0_k_ion = iki
    nai0_na_ion = inai

    
    // set initial Ko Ki
    forall {
        nao = 140
        nai = inai
        //nai0_nai_acc = inai
        ko = ko0 
        ki = iki
        ki0_kdifl = iki 
        ko0_k_acc = ko0
        clo = 130
        cli = 30
        //cao = 2
        //cai = 50e-6 // 50 nM
        km_na_nakpump = inai
        km_k_nakpump = ko0 
    }
}


