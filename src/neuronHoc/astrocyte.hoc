objref sGluT, GluTs,ncGluList

GluTs = new List()
ncGluList = new List()

proc setGluTs(){local lenPAP localobj sref
    // $o1.printnames()
    lenGluTs = 0
    forall {
        segLen = L / nseg
        for i = 0,nseg-1 {
            pos = segLen * (i+0.5)
            normPos = pos/L
            sGluT = new GluTrans(normPos)
            GluTs.append(sGluT)
            ifsec $o1 {
                // psection()
                
                // print(lenPAP)
                nc = new NetCon(stim,sGluT)
                ncGluList.append(nc)
            }
            lenGluTs = lenGluTs + 1
        }
    }

}

proc fINITGLUT(){
    for i = 0, ncGluList.count - 1 {
        ncGluList.o(i).weight = 1
        ncGluList.o(i).delay = 0
        // print(nc.weight)
    }
}
