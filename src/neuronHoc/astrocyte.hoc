// Experimental manipulations
proc setK(){local tmp localobj sref
    // $o1.printnames()
    forsec $o1 {
        sref = new SectionRef()
        if ($4 > 0){
            //instantaneous switch of bath if flag 1
            flag_k_acc = $4
            //relative change of bath
            ko0_k_acc = $2 + getPAPK(sref)
            //relative change of ko
            ko = $2 + getPAPK(sref)
        } else {
            //relative change of ko
            ko = $2 + getPAPK(sref)
            flag_k_acc = 0
            //change of ko
            ko0_k_acc = $3
        }
        // psection()
        // printf("%g\n",getPAPK(sref))
    }
    soma sref = new SectionRef()
    // printf("%g\n",getPAPK(sref))
}

