proc ko_sim_on() {
  forall {
      flag_k_acc = 0
    }
  }


proc kbath_off() {
    forall {
        tauk_0_k_acc = exp(700) // esenntially infinite kclearence (Never clears) 3/0
    }
}
proc kbath_on() {
    forall {
        tauk_k_acc = 1 //((1e-4)*fhspace_k_acc - diam/2) * ((1e-4)*fhspace_k_acc - diam/2)/2/Dk_k_acc
    }
}
proc kbath_rule() {
    forall {
        tauk_0_k_acc = $1 // esenntially decide tauk
    }
}

proc set_kobase(){
    forall {
        ko0_k_acc = $1
    }
}
proc setNak_pump(){
  forall {
    if ($1 == 0) {
      totalpump_nakpump = 0
      }
    }
}
proc setECS(){local soma_area,total_area
  if ($2 == 0) {
    forall fhspace_k_acc = $1
  } else {
    soma_area = 0
    soma {for (x) soma_area = soma_area + area(x)}
    forall {
      total_area = 0
      for (x) total_area = total_area + area(x)
      fhspace_k_acc = $1 * sqrt(total_area) / sqrt(soma_area)
      }
    }
}

proc set_gleakNa() {local tmp_gk, rmp,count_kir,tmp_gna
    forall {
      rmp = $1 
      count_kir = count_kir2 + multiple_kir2*count_std_kir2

      tmp_gk = (count_kir *gkbar_kir2*A_kir2*sqrt(3)*(1e-4)*linf_kir2+ gleak_kleak*area(0.5))
      tmp_gna = -((rmp-ek)* tmp_gk)/(rmp-ena)
      tmp_gna = tmp_gna/area(0.5)
      gleak_naleak = tmp_gna
      }
  }
func u_glut() {
    return exp($2*$1/(2*(26.7)))
  }

