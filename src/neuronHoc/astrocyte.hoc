func calc_fhspace(){local min_ecs,max_ecs,max_d,min_d
  min_ecs = 20
max_ecs = 1000
min_d = 0.1
max_d = 6.5 

  return min_ecs + (max_ecs-min_ecs)*log($1/min_d)/log(max_d/min_d) 
  }

