proc setGABAas(){local lenPAP
    lenPAP = 0
    // $o1.printnames()
    forsec $o1 {
        segLen = L / nseg
        if (segLen >= lenUnits){
          for i = 0,nseg-1 {
              pos = segLen * (i+0.5)
              normPos = pos/L
              sGABAa = new inhSyn(normPos)
              GABAas.append(sGABAa)
              nc = new NetCon(stim,GABAas.o(lenPAP))
              ncGABAaList.append(nc)
              lenPAP = lenPAP + 1
          }
      } else {
        sGABAa = new inhSyn(0.5)
        GABAas.append(sGABAa)
        nc = new NetCon(stim,GABAas.o(lenPAP))
        ncGABAaList.append(nc)
        lenPAP = lenPAP + 1
    }
}
}

proc fINITGABAa(){
    for i = 0, ncGABAaList.count - 1 {
        ncGABAaList.o(i).weight = 1.5
        ncGABAaList.o(i).delay = 0
        // print(nc.weight)
    }
}
