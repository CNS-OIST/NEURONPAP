obfunc getLeaf() {localobj sec,leaf
    forsec $o1 {
        sec = new SectionRef()
        // psection()
        if (sec.nchild == 0) {
            leaf = new SectionRef()
        }
    }
    return leaf
}

// inserting NMDARs
objref sNMDA, NMDAs, stim, nc, ncNMDAList

NMDAs = new List()
ncNMDAList = new List()

stim = new NetStim(.5)
stim.interval = 1
stim.number = 1
stim.start = 50
stim.noise = 0

double lenPAP[1]
lenPAP = 0
// slPAP.printnames()
// print(lenPAP)
proc setNMDAs(){
    // $o1.printnames()
    forsec $o1 {
        sNMDA = new Exp5NMDA(0.5)
        // sNMDA = new SimpleNMDA(0.5)
        NMDAs.append(sNMDA)
        nc = new NetCon(stim,NMDAs.o(lenPAP))
        ncNMDAList.append(nc)
        lenPAP = lenPAP + 1
    }
}

proc fINITNMDA(){
    for i = 0, ncNMDAList.count - 1 {
        ncNMDAList.o(i).weight = 1
        ncNMDAList.o(i).delay = 0
        // print(nc.weight)
    }
}
objref FinNMDA
FinNMDA = new FInitializeHandler(3,"fINITNMDA()")

