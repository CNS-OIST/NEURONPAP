proc setNMDAs(){local lenPAP
    lenPAP = 0
    // $o1.printnames()
    forsec $o1 {
        //sNMDA = new Exp5NMDA(0.5)
        //NMDAs.append(sNMDA)
        //nc = new NetCon(stim,NMDAs.o(lenPAP))
        segLen = L / nseg
        if (segLen >= lenUnits){
          for i = 0,nseg-1 {
              pos = segLen * (i+0.5)
              normPos = pos/L
              sNMDA = new Exp5NMDA_N2C(normPos)
              NMDAs.append(sNMDA)
              nc = new NetCon(stim,NMDAs.o(lenPAP))
              ncNMDAList.append(nc)
              lenPAP = lenPAP + 1
          }
          } else {
              sNMDA = new Exp5NMDA_N2C(0.5)
              NMDAs.append(sNMDA)
              nc = new NetCon(stim,NMDAs.o(lenPAP))
              ncNMDAList.append(nc)
              lenPAP = lenPAP + 1
          }
        }
    }


proc fINITNMDA(){
    for i = 0, ncNMDAList.count - 1 {
        ncNMDAList.o(i).weight = 1
        ncNMDAList.o(i).delay = 0
        // print(nc.weight)
    }
}
