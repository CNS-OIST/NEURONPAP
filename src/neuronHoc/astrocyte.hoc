objref r
r = new Random(0)

// Function to get end section
obfunc get_randomfinalSection() {local rint localobj child_sections, current_section
    child_sections = new SectionList()
    
    // Start from the currently accessed section
    $o1 current_section = new SectionRef()
    current_section.root() current_section = new SectionRef()
    // Iterate through parent sections
    while (current_section.nchild > 0) {
        current_section.sec {
            // psection()
            child_sections.append()
        }
        rint = r.uniform(0,current_section.nchild)
        current_section.child[rint] current_section = new SectionRef()
    }

    return current_section
}

// Function to get parent sections
obfunc get_parent_sections() {local totalLen, lenThr localobj parent_sections, current_section 
    parent_sections = new SectionList()
    
    // Start from the currently accessed section
    // $o1 {psection()}
    $o1 current_section = new SectionRef()
    totalLen = 0
    lenThr = 0.3 // micron
    // Iterate through parent sections
    current_section.sec {
        // psection()
        parent_sections.append()
    }
    while (current_section.has_parent && totalLen < lenThr) {
        totalLen = totalLen + current_section.sec.L
        // current_section.sec {
        //     psection()
        // }
        
        current_section.parent {
            parent_sections.append()
            current_section = new SectionRef()
        }
    }
    parent_sections.unique()
    return parent_sections
}

// Actually getting things

objref sref,slPAP

soma sref = new SectionRef()
get_randomfinalSection(sref).sec {
    // psection()
    sref = new SectionRef()
    slPAP = get_parent_sections(sref)
}
// slPAP.printnames()

obfunc getLeaf() {localobj sec,leaf
    forsec $o1 {
        sec = new SectionRef()
        // psection()
        if (sec.nchild == 0) {
            leaf = new SectionRef()
        }
    }
    return leaf
}

// inserting NMDARs
objref sNMDA, NMDAs, stim, nc, ncList

NMDAs = new List()
ncList = new List()

stim = new NetStim(.5)
stim.interval = 1
stim.number = 1
stim.start = 50
stim.noise = 0

double lenPAP[1]
lenPAP = 0
forsec slPAP {
    lenPAP = lenPAP + 1
}
// print(lenPAP)

for i = 0, lenPAP - 1 {
    sNMDA = new Exp5NMDA(0.5)
    NMDAs.append(sNMDA)
    nc = new NetCon(stim,NMDAs.o(i))
    ncList.append(nc)
}


proc fINITNMDA(){
    for i = 0, ncList.count - 1 {
        ncList.o(i).weight = 1.26e01
        ncList.o(i).delay = 0
        // print(nc.weight)
    }
}
objref FinNMDA
FinNMDA = new FInitializeHandler(3,"fINITNMDA()")



//initialize Ko
proc initIon(){local iki,inai
    iki = 80 //ek set to -92
    inai = 15 // Verhratsky A 2019 review
    
    // set global Ki
    ki0_k_ion = iki
    nai0_na_ion = inai

    
    // set initial Ko Ki
    forall {
        nao = 140
        ko = 2.5
        clo = nao + ko
        ki = iki
        nai = inai
    }
}


objref FinIon
{FinIon = new FInitializeHandler(1,"initIon()")}

// Experimental manipulations
proc setK(){
    forsec slPAP {
        if ($3 == 1){ //instantaneous switch of bath
            flag_k_acc = 1
        } else {
            flag_k_acc = 0
        }
        ko = $1
        ko0_k_acc = $2
        // psection()
    }
}

func getPAPK(){local papko
    getLeaf(slPAP){ papko = ko } //warning message if return in between sectionList
    return papko
}

objref ic,vc,electrodeList
{electrodeList = new List()}

proc clampSwitch() {
    if ($1 > 1) {
        //------------current Clamp---------------------------
        if ($1 > 2){
            soma {ic = new IClamp(0.5)}
        } else {
            getLeaf(slPAP) {ic = new IClamp(0.5)}
        }
        ic.dur = tstop
        ic.del = 0  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection (1 pA)
        electrodeList.append(ic)
        //---------------------------------------------------
    } else if ($1 > 0) {
        // voltage clamp
        getLeaf(slPAP) {vc = new VClamp(0.5)}
        vc.dur[0] = tstop
        vc.amp[0] = $2  // mV depolarization (dV = 20)
        electrodeList.append(vc)
        //---------------------------------------------------
        
    } else {
        // Pulse Current
        getLeaf(slPAP) {ic = new IClamp(0.5)}
        ic.dur = 0.002
        ic.delay = 10  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection
        electrodeList.append(ic)
        //---------------------------------------------------
    }
}



