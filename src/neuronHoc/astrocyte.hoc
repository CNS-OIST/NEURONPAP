// Function to get end section
obfunc getPath() {localobj current_section,sl
    $o1 current_section = new SectionRef()
    sl = new SectionList()
    while (current_section.has_parent()) {
        current_section.sec sl.append()
        current_section.parent current_section = new SectionRef()
    }
    // sl.printnames()
    return sl
}

obfunc get_randomfinalSection() {local rint,countDist,nchildless,blacklist_count localobj child_sections, current_section, blacklist,secref
    child_sections = new SectionList()
    blacklist = new SectionList()
    // Start from the currently accessed section
    $o1 current_section = new SectionRef()
    current_section.root() current_section = new SectionRef()
    current_section.sec { distance(0,0.5) } // set origin at root
    // find total candidate
    nchildless = 0
    forall {
        secref = new SectionRef()
        if (secref.nchild == 0){
            nchildless = nchildless + 1
        }
    }
    // Iterate through parent sections
    blacklist_count = 0
    while (current_section.nchild > 0 && blacklist_count < nchildless) {
        current_section.sec {
            // psection()
            child_sections.append()
        }
        if (current_section.nchild > 1){
            rint = r.discunif(0,current_section.nchild - 1)
        } else if (current_section.nchild == 1) {
            rint = 0
        }
        current_section.child[rint] current_section = new SectionRef()
        // check distance and reselect if closer than 50
        current_section.sec countDist = distance(0.5)
        if (current_section.nchild == 0 && countDist < 50) {
            current_section.sec {
                blacklist.append()
            }
            blacklist_count = blacklist_count + 1
            // current_section.sec {
            //     psection()
            // }
            // printf("Found but changing\n")
            // go back and reselect if not suitable
            current_section.root() current_section = new SectionRef()
        }
    }
    return current_section
}

obfunc shiftPAP() {local shift_dist,totalShift localobj current_section
shift_dist = $2 //micron
  $o1 current_section = new SectionRef()
  totalShift = 0
  while (totalShift < shift_dist) {
      totalShift = totalShift + L
      current_section.parent current_section = new SectionRef()
    }
    //print "shifted PAP from end by ", totalShift
  return current_section
  }

//get last section fitting criteria
obfunc get_midAstrocytePAP() {localobj candidate
    soma { distance(0,0.5) } // set origin at root
    forall {if (diam < $1 && distance(0.5) < $2) {
        candidate = new SectionRef()
    }} return candidate
}


obfunc get_randomSection() {local lenThr,rloc,rint localobj current_section, child_sections
    lenThr = $2
    child_sections = new SectionList()
    // Start from the currently accessed section
    $o1 current_section = new SectionRef()
    current_section.root() current_section = new SectionRef()
    current_section.sec { distance(0,0.5) } // set origin at root
    // Iterate through parent sections
    while (current_section.nchild > 0) {
        current_section.sec {
            // psection()
            child_sections.append()
        }
        // random selection Goto child or self
        if (current_section.nchild > 1){
            rint = r.discunif(0,current_section.nchild)
        } else if (current_section.nchild == 1) {
            rint = 0
        }
        // if random self check if appropriate
        if (rint  == current_section.nchild) {
            if (current_section.sec.L / current_section.sec.nseg < lenThr) {
                rloc = r.discunif(0,current_section.sec.nseg) / current_section.sec.nseg
                // Simplified PAP
                // ToDo make smarter extract other PAPs
                // or specifically select as PAP
                create artificialPAP
                artificialPAP {
                    L = 0.3
                    diam = 0.1
                    nseg = 1
                }
                artificialPAP connect current_section.sec(rloc), 1
                    
                return artificialPAP
            } else {
            rint = r.discunif(0,current_section.nchild - 1)                
            }
        }
        current_section.child[rint] current_section = new SectionRef()            
    }
    return current_section    
}

obfunc get_NodeSection() {local ID,skipCount localobj current_section,strobj
    ID = $2
    skipCount = 0
    strobj = new StringFunctions()
    forall {
        if (strobj.substr(secname(),"Node") >= 0) {
            if (ID == skipCount) {
                current_section = new SectionRef()
                return current_section
            } else {
                skipCount += 1
            }
        }
    }
    return
}

// Function to get parent sections
obfunc get_parent_sections() {local totalLen, lenThr localobj parent_sections, current_section 
    parent_sections = new SectionList()
    
    // Start from the currently accessed section
    // $o1 {psection()}
    $o1 current_section = new SectionRef()
    totalLen = 0
    lenThr = $2 // micron
    // Iterate through parent sections
    if (lenThr > 0) {
        current_section.sec {
            // psection()
            parent_sections.append()
        }
    }
    while (current_section.has_parent && totalLen < lenThr) {
        totalLen = totalLen + current_section.sec.L
        // current_section.sec {
        //     psection()
        // }
        
        current_section.parent {
            parent_sections.append()
            current_section = new SectionRef()
        }
    }
    // parent_sections.printnames()
    parent_sections.unique()
    return parent_sections
}

