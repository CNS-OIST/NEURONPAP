//initialize Ko
proc initIon(){local iki,inai
    iki = 80 //ek set to -92
    inai = 15 // Verhratsky A 2019 review
    
    // set global Ki
    ki0_k_ion = iki
    nai0_na_ion = inai

    
    // set initial Ko Ki
    forall {
        nao = 140
        ko = 2.5
        clo = nao + ko
        ki = iki
        nai = inai
    }
}


objref FinIon
{FinIon = new FInitializeHandler(1,"initIon()")}

// Experimental manipulations
proc setK(){
    // $o1.printnames()
    forsec $o1 {
        if ($4 == 1){ //instantaneous switch of bath
            flag_k_acc = 1
        } else {
            flag_k_acc = 0
        }
        ko = $2
        ko0_k_acc = $3
        // psection()
    }
}

func getPAPK(){local papko
    $o1 { papko = ko } //warning message if return in between sectionList
    return papko
}

objref ic,vc,electrodeList
{electrodeList = new List()}

proc clampSwitch() {
    if ($1 > 1) {
        //------------current Clamp---------------------------
        if ($1 > 2){
            soma {ic = new IClamp(0.5)}
        } else {
            getLeaf(slPAP) {ic = new IClamp(0.5)}
        }
        ic.dur = tstop
        ic.del = 0  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection (1 pA)
        electrodeList.append(ic)
        //---------------------------------------------------
    } else if ($1 > 0) {
        // voltage clamp
        getLeaf(slPAP) {vc = new VClamp(0.5)}
        vc.dur[0] = tstop
        vc.amp[0] = $2  // mV depolarization (dV = 20)
        electrodeList.append(vc)
        //---------------------------------------------------
        
    } else {
        // Pulse Current
        getLeaf(slPAP) {ic = new IClamp(0.5)}
        ic.dur = 0.002
        ic.delay = 10  // ms starts with glutamate
        ic.amp = $2 * 0.001  // nA current injection
        electrodeList.append(ic)
        //---------------------------------------------------
    }
}

// Function to plot neuron topology with highlighted sections
proc plot_topology() {localobj rando, sref,slPAP,ps
    sref = new SectionList()
    soma { sref.wholetree() }
    // Plot the astrocyte's topology
    ps = new PlotShape(sref)
    ps.color_all(1)
    
    soma sref = new SectionRef()
    // $o1.printnames()
    
    // Highlight specified sections
    ps.color_list($o1,2)
    // Save the plot as a PostScript file
    ps.printfile("astrocyte_topology.psf")
}

proc plot_varMorph() {localobj rando, sref,slPAP,ps
    sref = new SectionList()
    soma { sref.wholetree() }
    // Plot the astrocyte's topology
    ps = new PlotShape(sref)
    ps.variable($s1) // plot variable 2
    if (strcmp($s1,"v")==0){
        ps.scale(-90,-50)
    } else if (strcmp($s1,"ko")==0) {
        ps.scale(0,10)
    }
    ps.exec_menu("Shape Plot")
    ps.exec_menu("Show Diam")
    ps.printfile($s2)//print as arg 2 file name
}
