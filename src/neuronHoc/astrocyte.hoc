  }
proc set_gapv(){
  for i=0,gaplist.count - 1{
    gaplist.o(i).VoltageGap = $1

    }

  }

func get_distance() {local dx, dy, dz,xo,yo,zo
soma xo = x3d(0)
soma yo = y3d(0)
soma zo = z3d(0)
dx = $1 - xo
dy = $2 - yo
dz = $3 - zo

return sqrt(dx*dx+dy*dy+dz*dz)
}

func get_max_dist () { local maxDist,tmp
maxDist = 0.0
forall {
           for i=0, n3d() - 1 {
            tmp =  get_distance(x3d(i),y3d(i),z3d(i))
            if (tmp > maxDist) {
              maxDist = tmp
              }
            } 
          }
  return maxDist
  }



objref shell_compartments
shell_compartments = new List()

obfunc define_shell() {local max_p,tmp,j,maxDist,total_shells,shell_width,synapse localobj synapse_track,sl,removed
total_shells = $1
synapse = $2
maxDist = get_max_dist()
shell_width = (maxDist + 1)/ total_shells
r.discunif(0,max_p)

max_p = 0
forall {max_p = max_p + 1}
max_p = int(max_p / total_shells/synapse)
if (max_p > 0) {
  max_p = max_p - 1
  } else {
      max_p = 0
  }

synapse_track = new Vector(total_shells)
for i=0,total_shells-1 {
  synapse_track.x[i] = 0
    shell_compartments.append(new SectionList())
  }


  forall {
    for i=0, n3d() - 1 {
        tmp = get_distance(x3d(i),y3d(i),z3d(i))
        j = -1
        while (tmp >= 0) {
            tmp = tmp - shell_width
            j = j + 1
        }
        insert shell
        num_shell = j
        if (synapse_track.x[j] < synapse*lenUnits) {
            shell_compartments.o(j).append()
            if (L > lenUnits){
                syn_add = int(L / lenUnits)
                if (syn_add < L/lenUnits){
                  syn_add = syn_add + 1
                  }

            } else {
                syn_add = 1
            }
            synapse_track.x[j] = synapse_track.x[j] +syn_add 
        }
  }}
  removed = new Vector()
  for i=0,total_shells-1 {
    removed.append(shell_compartments.o(i).unique())
  }
  return removed

}

proc set_all_pp(){
      for i=0, ncNMDAList.count - 1{
        ncNMDAList.o(i).active($1)
      }
    for i=0,ncGABAaList.count - 1{
      ncGABAaList.o(i).active($1)
      }

    for i=0,ncGluList.count - 1{
      ncGluList.o(i).active($1)
      }

  }

  proc select_shell() {local mode localobj tmpsl
  mode = $2
  
  tmpsl = new SectionList()
    if ($1 == shell_compartments.count){
      print "adding all shells"
      for i=0,shell_compartments.count-1 {
          if (mode > 0) {
            if (i < 5) {
                continue
              }

            } else if (mode > 1) {
                if (i < 6) {
                    continue
                  }
              }

      forsec shell_compartments.o(i) {
        tmpsl.append()
        }
      }
      } else {
    tmpsl = shell_compartments.o($1-1)
        }
        slPAP = tmpsl
    }

proc set_vgap(){
    for i=0,gaplist.count - 1{
      gaplist.o(i).VoltageGap = $1

    }
  }
