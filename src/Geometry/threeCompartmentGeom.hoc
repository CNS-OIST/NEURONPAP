// construct morphology
// Ball Stick PAP model
// must have soma section, PAP section
create branch
branch {
    L = 30
    diam =  3
    nseg = 10 
}

create soma
soma {
    L = 10
    diam = 10
    nseg = 1
}

soma connect branch(0),1

create PAP
PAP {
    L = 8.4e-04
    diam = 8.4e-04
    nseg = 1
}

branch connect PAP(0),1
